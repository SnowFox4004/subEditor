{
  "name": "srt-editor",
  "private": true,
  "version": "0.1.0",
  "description": "纯浏览器端的字幕编辑器：多标签页、可视化编辑、批量替换、多格式导出。零后端，部署于 Cloudflare Pages。",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=srteditor --branch=production"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
